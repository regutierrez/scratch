{
  "name": "armchair-tldraw",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:web dev:server",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "bun --hot server.ts",
    "build": "tsc -b && vite build",
    "check": "tsc -b"
  },
  "dependencies": {
    "@tldraw/tldraw": "^5.4.2",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
